#!/usr/bin/env bash
# bct: one command for the toolkit.  bct <look|layers|vector|gimp|video|img|scad|paint|fx|font|audio|doctor> ...   (bct help)
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export PATH="$HOME/.local/bin:$PATH"
cmd="${1:-help}"; shift 2>/dev/null
case "$cmd" in
  look)   exec python3 "$HERE/tools/look.py" "$@";;
  layers) exec python3 "$HERE/tools/layers.py" "$@";;
  vector) exec python3 "$HERE/tools/vector.py" "$@";;
  gimp)   exec python3 "$HERE/tools/gimp_run.py" "$@";;
  video)  exec python3 "$HERE/tools/video.py" "$@";;
  img)    exec python3 "$HERE/tools/img.py" "$@";;
  scad)   exec python3 "$HERE/tools/scad.py" "$@";;
  paint)  exec python3 "$HERE/tools/paint.py" "$@";;
  fx)     exec python3 "$HERE/tools/fx.py" "$@";;
  font)   exec python3 "$HERE/tools/font.py" "$@";;
  audio)  exec python3 "$HERE/tools/audio.py" "$@";;
  doctor) exec "$HERE/setup.sh" --check;;
  help|-h|--help)
    cat <<EOF
bct look   MODEL.blend|scene.py -o sheet.png    render several angles into one contact sheet
bct layers render|new|list|add|set|replace|move|hide|show|reorder|remove|from-ora ...   layered images (JSON -> PNG/ORA)
bct vector trace|new|add|set|recolor|delete|list|export ...    bitmap->SVG, SVG edits, PNG export
bct gimp   convert IN OUT | script FILE.py | eval "python code"   run GIMP headless
bct video  encode|turntable|trim|sheet|probe ...   frames->MP4/GIF, model turntables, trims, frame sheets (FFmpeg)
bct img    resize|crop|icons|montage|convert|adjust|info batch raster jobs (ImageMagick 7)
bct scad   render|png|params MODEL.scad ...          OpenSCAD to STL + previews, -D parameters
bct paint  export|info|stack|script ...             Krita headless: .kra/.ora/.psd/.png conversion, layered files, Python
bct fx     apply|strip|gui|list|run ...              G'MIC artistic filters by name (painting, cartoon, sketch ...)
bct font   build|specimen|convert|info ...           FontForge: font from SVG letters, specimen PNG, TTF/OTF/WOFF2
bct audio  tone|noise|synth|trim|fade|norm|concat|mix|fx|wave|spectrogram|probe ...   SoX sound, with pictures
bct doctor                                      show what is installed
Add --help after any command for its options. Guide: $HERE/AGENTS.md
EOF
    ;;
  *) echo "unknown command: $cmd (try: bct help)" >&2; exit 2;;
esac
